module Knockapi
  module Resources
    class Users
      class Guides
        def get_channel: (
          String user_id,
          String channel_id,
          ?data: String,
          ?tenant: String,
          ?type: String,
          ?request_options: Knockapi::request_opts
        ) -> Knockapi::Models::Users::GuideGetChannelResponse

        def mark_message_as_archived: (
          String user_id,
          channel_id: String,
          guide_id: String,
          guide_key: String,
          guide_step_ref: String,
          ?is_final: bool,
          ?tenant: String,
          ?unthrottled: bool,
          ?request_options: Knockapi::request_opts
        ) -> Knockapi::Users::GuideActionResponse

        def mark_message_as_interacted: (
          String user_id,
          channel_id: String,
          guide_id: String,
          guide_key: String,
          guide_step_ref: String,
          ?metadata: ::Hash[Symbol, top],
          ?tenant: String,
          ?request_options: Knockapi::request_opts
        ) -> Knockapi::Users::GuideActionResponse

        def mark_message_as_seen: (
          String user_id,
          channel_id: String,
          content: ::Hash[Symbol, top],
          guide_id: String,
          guide_key: String,
          guide_step_ref: String,
          ?data: ::Hash[Symbol, top],
          ?tenant: String,
          ?request_options: Knockapi::request_opts
        ) -> Knockapi::Users::GuideActionResponse

        def reset_guide_engagements: (
          String user_id,
          guide_key: String,
          ?tenant: String,
          ?request_options: Knockapi::request_opts
        ) -> Knockapi::Users::GuideActionResponse

        def unarchive_guide_message: (
          String user_id,
          guide_key: String,
          ?tenant: String,
          ?request_options: Knockapi::request_opts
        ) -> Knockapi::Users::GuideActionResponse

        def initialize: (client: Knockapi::Client) -> void
      end
    end
  end
end
